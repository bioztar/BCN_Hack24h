{
  "name": "@dg-roast/analyzer",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "dev": "tsx src/dev.ts",
    "dev:watch": "tsx watch src/dev.ts",
    "dev:web": "vite --config web/vite.config.ts",
    "start": "tsx src/dev.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit && tsc --noEmit -p web",
    "build": "npm run typecheck && vite build --config web/vite.config.ts",
    "vendor:skills": "tsx scripts/vendor-skills.ts"
  },
  "dependencies": {
    "@fastify/multipart": "10.1.2",
    "@fastify/static": "10.1.3",
    "fastify": "5.12.5",
    "mammoth": "1.12.3",
    "pdf-parse": "2.4.5",
    "tsx": "4.23.13"
  },
  "devDependencies": {
    "@types/node": "22.20.2",
    "typescript": "7.0.2",
    "vite": "8.3.2",
    "vitest": "5.0.3"
  },
  "files": [
    "src",
    "skills",
    "web/dist"
  ]
}
