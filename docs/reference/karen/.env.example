# --- inference (Nebius Token Factory) -------------------------------------
# The ONLY model provider. Profiles live in config/models.yaml.
NEBIUS_API_KEY=

# --- voice (SLNG, same account gavel uses) --------------------------------
SLNG_API_KEY=
# SLNG_BASE_URL=https://eu-west.api.slng.ai
# Karen's voice: the Fish clone gavel uses. Model is the /v1/tts/{model} route,
# voice is Fish's reference_id.
# SLNG_TTS_MODEL=slng/fish/tts:s2.1-pro
# SLNG_TTS_VOICE=16cabdb7f8d240569aff36c9e480d783
# Brad, the manager. Deepgram Aura, corporate baritone.
# SLNG_TTS_MODEL_BRAD=deepgram/aura:2
# SLNG_TTS_VOICE_BRAD=aura-2-orion-en
# Tried once when Karen's voice fails or takes longer than SLNG_TTS_TIMEOUT_MS.
# SLNG_TTS_FALLBACK_MODEL=deepgram/aura:2
# SLNG_TTS_FALLBACK_VOICE=aura-2-thalia-en
# SLNG_TTS_TIMEOUT_MS=6000
# Push-to-talk: the visitor's clip goes to SLNG speech-to-text.
# SLNG_STT_MODEL=deepgram/nova:3
# SLNG_STT_LANGUAGE=en
# SLNG_STT_TIMEOUT_MS=15000

# --- Karen Live (fal, MiniMax H3 Max Director) ------------------------------
# Optional. Unset -> the "Karen Live" toggle is hidden and nothing else changes.
# Billed per second of video: the caps below are what stop a demo becoming an invoice.
FAL_API_KEY=
# Concurrent Director sessions the server will open, across all visitors.
KAREN_LIVE_MAX_SESSIONS=2
# Longest one session may live before the server stops answering its heartbeat.
KAREN_LIVE_MAX_SECONDS=150
# Hard ceiling on streamed seconds per UTC day, everyone together (900 s ~ $72). Counted
# from the moment a slot is reserved, by the server clock, kept in $DATA_DIR/live-spend.json
# so a restart does not reset it. Exhausted -> "Karen Live is off for today", chat as usual.
KAREN_LIVE_DAILY_SECONDS=900
# Streamed seconds per client (conversation cookie + IP) per UTC day; one stream at a time each.
KAREN_LIVE_PER_CLIENT_SECONDS=300
# An ended or expired session keeps its slot this long: fal has no server-side stop for a
# realtime session, so the stream may run until its lease lapses. Stops a start/stop loop
# from running more streams than KAREN_LIVE_MAX_SESSIONS.
# KAREN_LIVE_COOLDOWN_SECONDS=90
# Seconds with no reply before the browser hangs up.
# KAREN_LIVE_IDLE_SECONDS=60
# Proxy calls per IP per minute (a session heartbeats 12x/min).
# KAREN_LIVE_PROXY_PER_MINUTE=60
# The only fal app the proxy will talk to, and the bridge it talks to it through.
# KAREN_LIVE_ENDPOINT=minimax/h3-max/director
# KAREN_LIVE_BRIDGE_URL=https://wma.fal.run

# --- server ----------------------------------------------------------------
PORT=8795
# Public origin, used for receipt-card absolute URLs and for the URLs fal fetches
# (Karen's reference image, her voice clips) when Karen Live is on.
PUBLIC_ORIGIN=https://karen.pro7ocol.com
# Rate limit: messages per IP per rolling hour. Caps Nebius spend.
RATE_LIMIT_PER_HOUR=20
# SQLite location (wall of shame + rate limit buckets).
DATA_DIR=/data
